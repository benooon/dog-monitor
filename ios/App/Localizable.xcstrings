{
  "sourceLanguage": "en",
  "strings": {
    "Barks in the last minute: %lld": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נביחות בדקה האחרונה: %lld"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה"
          }
        }
      }
    },
    "Camera access is off. Allow it in Settings to use this phone as a camera.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למצלמה כבויה. אפשרו אותה בהגדרות כדי להשתמש בטלפון הזה כמצלמה."
          }
        }
      }
    },
    "Camera on": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצלמה פועלת"
          }
        }
      }
    },
    "Cameras": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמות"
          }
        }
      }
    },
    "Change role": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפת תפקיד"
          }
        }
      }
    },
    "Couldn't start the camera.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להפעיל את המצלמה."
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירה"
          }
        }
      }
    },
    "Create your household": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת משק בית"
          }
        }
      }
    },
    "Dog Monitor": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Dog Monitor"
          }
        }
      }
    },
    "Dog's name (optional)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם הכלב (לא חובה)"
          }
        }
      }
    },
    "Dogs": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלבים"
          }
        }
      }
    },
    "Family members and cameras join your household later with an invite.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בני משפחה ומצלמות יצטרפו למשק הבית מאוחר יותר באמצעות הזמנה."
          }
        }
      }
    },
    "Household name": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם משק הבית"
          }
        }
      }
    },
    "How will this device be used?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איך ישמש המכשיר הזה?"
          }
        }
      }
    },
    "Keep this phone plugged in and the app open.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירו את הטלפון מחובר לחשמל ואת האפליקציה פתוחה."
          }
        }
      }
    },
    "Leave this phone at home to watch your dog.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירו את הטלפון הזה בבית כדי לשמור על הכלב שלכם."
          }
        }
      }
    },
    "Microphone off — barking can't be detected.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון כבוי — לא ניתן לזהות נביחות."
          }
        }
      }
    },
    "No cameras yet. Pair a spare iPhone as a camera.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מצלמות. חברו אייפון פנוי כמצלמה."
          }
        }
      }
    },
    "Offline": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנותקת"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחוברת"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת ההגדרות"
          }
        }
      }
    },
    "Sign in failed. Please try again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתחברות נכשלה. נסו שוב."
          }
        }
      }
    },
    "Sign in to watch your dog from anywhere.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו כדי לצפות בכלב שלכם מכל מקום."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקות"
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. נסו שוב."
          }
        }
      }
    },
    "Start camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלת המצלמה"
          }
        }
      }
    },
    "Starting camera…": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל את המצלמה…"
          }
        }
      }
    },
    "Stop camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצירת המצלמה"
          }
        }
      }
    },
    "Tap the screen to show the preview.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על המסך כדי להציג את התמונה."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו שוב"
          }
        }
      }
    },
    "Viewer": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צופה"
          }
        }
      }
    },
    "Watch live and get alerts on your own phone.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפו בשידור חי וקבלו התראות בטלפון שלכם."
          }
        }
      }
    }
  },
  "version": "1.0"
}
