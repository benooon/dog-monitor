{
  "sourceLanguage": "en",
  "strings": {
    "%lld watching": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld צופים"
          }
        }
      }
    },
    "Allow camera access to scan, or type the code.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו גישה למצלמה כדי לסרוק, או הקלידו את הקוד."
          }
        }
      }
    },
    "Barks in the last minute: %lld": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נביחות בדקה האחרונה: %lld"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה"
          }
        }
      }
    },
    "Camera access is off. Allow it in Settings to use this phone as a camera.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למצלמה כבויה. אפשרו אותה בהגדרות כדי להשתמש בטלפון הזה כמצלמה."
          }
        }
      }
    },
    "Camera on": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצלמה פועלת"
          }
        }
      }
    },
    "Cameras": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמות"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול"
          }
        }
      }
    },
    "Change role": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפת תפקיד"
          }
        }
      }
    },
    "Couldn't start the camera.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להפעיל את המצלמה."
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירה"
          }
        }
      }
    },
    "Create your household": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת משק בית"
          }
        }
      }
    },
    "Dog Monitor": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Dog Monitor"
          }
        }
      }
    },
    "Dog's name (optional)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם הכלב (לא חובה)"
          }
        }
      }
    },
    "Dogs": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלבים"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיום"
          }
        }
      }
    },
    "Expires in %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתוקף עוד %@"
          }
        }
      }
    },
    "Family members and cameras join your household later with an invite.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בני משפחה ומצלמות יצטרפו למשק הבית מאוחר יותר באמצעות הזמנה."
          }
        }
      }
    },
    "Household name": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם משק הבית"
          }
        }
      }
    },
    "How will this device be used?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איך ישמש המכשיר הזה?"
          }
        }
      }
    },
    "Invite": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנה"
          }
        }
      }
    },
    "Invite code": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד הזמנה"
          }
        }
      }
    },
    "Join": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרפות"
          }
        }
      }
    },
    "Join a household": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרפות למשק בית"
          }
        }
      }
    },
    "Keep this phone plugged in and the app open.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירו את הטלפון מחובר לחשמל ואת האפליקציה פתוחה."
          }
        }
      }
    },
    "Leave this phone at home to watch your dog.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירו את הטלפון הזה בבית כדי לשמור על הכלב שלכם."
          }
        }
      }
    },
    "Microphone off — barking can't be detected.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון כבוי — לא ניתן לזהות נביחות."
          }
        }
      }
    },
    "New invite": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנה חדשה"
          }
        }
      }
    },
    "No cameras yet. Pair a spare iPhone as a camera.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מצלמות. חברו אייפון פנוי כמצלמה."
          }
        }
      }
    },
    "Offline": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנותקת"
          }
        }
      }
    },
    "On the new phone, choose Camera and scan this code, or type the 6 digits. Family members can join with the same code.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטלפון החדש בחרו ״מצלמה״ וסרקו את הקוד, או הקלידו את 6 הספרות. בני משפחה יכולים להצטרף עם אותו קוד."
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחוברת"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת ההגדרות"
          }
        }
      }
    },
    "Or type the 6-digit code": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "או הקלידו את הקוד בן 6 הספרות"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צימוד"
          }
        }
      }
    },
    "Pair this camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צימוד המצלמה"
          }
        }
      }
    },
    "Scan the invite QR code from the owner's phone.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את קוד ה-QR של ההזמנה מהטלפון של הבעלים."
          }
        }
      }
    },
    "Sign in failed. Please try again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתחברות נכשלה. נסו שוב."
          }
        }
      }
    },
    "Sign in to watch your dog from anywhere.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו כדי לצפות בכלב שלכם מכל מקום."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקות"
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. נסו שוב."
          }
        }
      }
    },
    "Start camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלת המצלמה"
          }
        }
      }
    },
    "Starting camera…": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל את המצלמה…"
          }
        }
      }
    },
    "Stop camera": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצירת המצלמה"
          }
        }
      }
    },
    "Tap the screen to show the preview.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על המסך כדי להציג את התמונה."
          }
        }
      }
    },
    "This code is invalid or has expired.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד שגוי או שפג תוקפו."
          }
        }
      }
    },
    "This invite has expired.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף ההזמנה פג."
          }
        }
      }
    },
    "This phone isn't paired yet, so live view is off. Barking is still detected here.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטלפון הזה עדיין לא מצומד, לכן צפייה חיה כבויה. נביחות עדיין מזוהות כאן."
          }
        }
      }
    },
    "Too many attempts. Wait a minute and try again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות. המתינו דקה ונסו שוב."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו שוב"
          }
        }
      }
    },
    "Viewer": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צופה"
          }
        }
      }
    },
    "Watch live and get alerts on your own phone.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפו בשידור חי וקבלו התראות בטלפון שלכם."
          }
        }
      }
    }
  },
  "version": "1.0"
}
