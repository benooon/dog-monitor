# Copy to .env for local development. On Railway, set these as service variables.

# HTTP server (Railway injects PORT automatically)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# PostgreSQL (Railway's Postgres plugin provides DATABASE_URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dogmonitor

# Auth: secret for our own JWTs (at least 32 random characters, e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_TTL_SECONDS=2592000
# Accepted Sign in with Apple audiences (the iOS bundle id), comma-separated
APPLE_AUDIENCES=com.benooon.dogmonitor

# Live video: LiveKit Cloud project (Settings → Keys). Leave all three empty to disable live view.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Push notifications: APNs auth key (developer.apple.com → Keys → Apple Push Notifications service).
# APNS_KEY_P8 is the .p8 file's contents; newlines may be written as \n. Leave the three empty to disable pushes.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_TOPIC=com.benooon.dogmonitor
# sandbox for Xcode debug builds, production for TestFlight / App Store
APNS_ENV=sandbox

# Universal Links for invite links (https://<this host>/invite/<token>). The Apple Developer team id;
# falls back to APNS_TEAM_ID. APPLE_BUNDLE_ID defaults to com.benooon.dogmonitor.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.benooon.dogmonitor

# Clip and snapshot storage: any S3-compatible bucket (Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto).
# Leave the bucket and keys empty to disable uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: true/false. Default: path-style for custom endpoints, virtual-hosted for Railway buckets.
S3_FORCE_PATH_STYLE=
# Clips and snapshots older than this are deleted daily (SPEC §10). Ignored when ENFORCE_PLAN_LIMITS=true:
# then each household keeps clips as long as its plan allows (free 1 day, premium 30 days).
CLIP_RETENTION_DAYS=7
# Timeline events and daily summaries older than this are deleted daily (at least 30)
EVENT_RETENTION_DAYS=365

# Premium (StoreKit 2). Subscription product ids that unlock premium, as created in App Store Connect.
APP_STORE_PRODUCT_IDS=com.benooon.dogmonitor.premium.monthly,com.benooon.dogmonitor.premium.yearly
# Non-consumable product ids that unlock Premium for good (Lifetime Premium).
APP_STORE_LIFETIME_PRODUCT_IDS=com.benooon.dogmonitor.premium.lifetime
# SHA-256 fingerprint of the trusted root for signed transactions; defaults to Apple Root CA - G3.
APPLE_ROOT_CA_SHA256=
# App Store environments to accept: Production, Sandbox, or both (comma-separated). Unset = both.
# App Review and TestFlight buy in the Sandbox against this server, so Production-only blocks their
# purchases; see docs/DECISIONS.md (2026-11-11) before setting it on Railway.
APP_STORE_ENVIRONMENT=
# true: plan limits apply (free: 1 camera, 2 people, clips kept 1 day; premium: 4 cameras, 6 people,
# 30 days; see src/billing/plans.ts). Leave off until the app sells premium.
ENFORCE_PLAN_LIMITS=false

# Admin routes (GET /waitlist/stats, sent as "Authorization: Bearer <token>"). At least 32 random
# characters (`openssl rand -hex 32`). Leave empty to hide them.
ADMIN_TOKEN=
