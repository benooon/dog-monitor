# Copy to .env for local development. On Railway, set these as service variables.

# HTTP server (Railway injects PORT automatically)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# PostgreSQL (Railway's Postgres plugin provides DATABASE_URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dogmonitor

# Auth: secret for our own JWTs (at least 32 random characters, e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_TTL_SECONDS=2592000
# Accepted Sign in with Apple audiences (the iOS bundle id), comma-separated
APPLE_AUDIENCES=com.benooon.dogmonitor
